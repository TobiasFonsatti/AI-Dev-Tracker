# Postgres do projeto Supabase — botão "Connect" no dashboard > ORMs > Prisma
# app em runtime — transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
# migrações (prisma db push / migrate) — session-mode pooler
DIRECT_URL="postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# Supabase — Settings > API > Publishable and secret API keys
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[chave publishable/anon]"
SUPABASE_SERVICE_ROLE_KEY="[chave secret/service_role — nunca expor no client]"
