# ============================================================
# AI-Dev-Tracker — Variáveis de Ambiente
# ============================================================
# Copie este ficheiro para .env e preencha os valores.
#   cp .env.example .env
#
# NUNCA faça commit do ficheiro .env (já está no .gitignore).
# ============================================================

# ----------------------------------------------------------
# PostgreSQL (Supabase) — Conexões do Prisma
# Onde encontrar: Supabase Dashboard → botão "Connect" (topo)
#                 → aba "ORMs" → selecionar "Prisma"
# ----------------------------------------------------------

# Conexão pooled (transaction mode, porta 6543)
# Usada pela aplicação em runtime
DATABASE_URL="postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (session mode, porta 5432)
# Usada pelo Prisma CLI para migrações e db push
DIRECT_URL="postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------
# Supabase Auth — Chaves de API
# Onde encontrar: Supabase Dashboard → Settings → API
# ----------------------------------------------------------

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[SEU-PROJETO].supabase.co"

# Chave publishable/anon (segura para expor no client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="[chave-anon-do-supabase]"

# Chave secret/service_role — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY="[chave-service-role-do-supabase]"
